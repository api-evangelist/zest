  "item": [
    {
      "id": "7c410f9f-46ec-4324-bf69-b05d69f3ca75",
      "name": "Subscription Forms",
      "description": {
        "content": "Upload signed subscription forms (PDF or image) for partner-managed subscriptions. Files are streamed to private storage and referenced on the Bid.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1a299fb8-87d3-47a5-a888-91785eda9f6a",
          "name": "Upload signed subscription form",
          "request": {
            "name": "Upload signed subscription form",
            "description": {
              "content": "Uploads a signed subscription form for a partner-managed subscription. Multipart/form-data with a single `file` field. Max 10 MB. Allowed content types: PDF, JPEG, PNG, WEBP. Emits `signed_subscription_form.uploaded` webhook on success.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "spvs",
                ":spv_slug",
                "subscription",
                ":person_id",
                "forms"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "spv_slug",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "person_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) "
                }
              ]
            }
