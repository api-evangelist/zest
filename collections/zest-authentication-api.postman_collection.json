          "id": "f76be122-baa8-4929-a8aa-83352f3ab4d1",
          "name": "Exchange a JWT assertion for an access token",
          "request": {
            "name": "Exchange a JWT assertion for an access token",
            "description": {
              "content": "OAuth 2.0 JWT-Bearer assertion grant. Submit `grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer` plus a signed JWT `assertion`. Returns a short-lived bearer access token used for subsequent partner API calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "oauth2",
                "tokens"
