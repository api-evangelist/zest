      "name": "Authentication",
      "description": {
        "content": "OAuth 2.0 JWT-Bearer assertion grant. Exchange a partner-signed JWT for a short-lived bearer access token, then send that token in the Authorization header on every partner API call.",
        "type": "text/plain"
      },
      "item": [
