        {
          "id": "f70898e6-8ba4-49e9-83a9-0f667924327b",
          "name": "Inspect the current access token",
          "request": {
            "name": "Inspect the current access token",
            "description": {
              "content": "Returns metadata about the bearer token currently presented in the Authorization header. Useful for verifying that a token corresponds to the expected partner application.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "oauth2",
                "info"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "c60fce28-c419-48f3-a035-74b0a6485f97",
              "name": "Successful Response",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "oauth2",
                    "info"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
